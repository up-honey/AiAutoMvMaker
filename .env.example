# The base project only enables the deterministic mock provider.
VIDEO_PROVIDER=mock
VITE_API_BASE_URL=

# Local PostgreSQL settings used by Docker Compose.
DB_NAME=fire
DB_USERNAME=fire
DB_PASSWORD=replace-with-a-local-password

# Add real provider credentials later. Never commit actual values.
OPENAI_API_KEY=CHANGEME
GOOGLE_CLOUD_PROJECT=CHANGEME
GOOGLE_CLOUD_LOCATION=CHANGEME
