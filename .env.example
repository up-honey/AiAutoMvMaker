# AI scene generation defaults to the deterministic mock provider.
VIDEO_PROVIDER=mock
VITE_API_BASE_URL=
FIRE_RENDER_TIMEOUT_MINUTES=30

# Gemini stays unavailable until both switches are true and an API key is supplied.
# A user must still confirm each paid generation in the Studio UI/API request.
FIRE_VIDEO_GEMINI_ENABLED=false
FIRE_VIDEO_GEMINI_PAID_GENERATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-omni-flash-preview
GEMINI_API_REVISION=2026-05-20
GEMINI_GENERATION_TIMEOUT_MINUTES=15
GEMINI_ESTIMATED_COST_PER_SECOND_USD=0.10
GEMINI_ESTIMATED_OUTPUT_SECONDS=10

# Local PostgreSQL settings used by Docker Compose.
DB_NAME=fire
DB_USERNAME=fire
DB_PASSWORD=replace-with-a-local-password

# Optional cloud project placeholders. Never commit actual credentials.
OPENAI_API_KEY=CHANGEME
GOOGLE_CLOUD_PROJECT=CHANGEME
GOOGLE_CLOUD_LOCATION=CHANGEME
